# ==============================================================================
# METHOX AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. AI API Configuration (Gemini 2.5 Flash / Claude)
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
GEMINI_API_KEY="AIzaSy..."
# Optional Claude API Key (if user prefers Claude for reasoning)
ANTHROPIC_API_KEY=""

# 2. Application Deployment URLs
APP_URL="https://methox-ai.yourdomain.com"
PORT=3000

# 3. Supabase / PostgreSQL Database Configuration
# Create a free project at https://supabase.com and copy credentials from Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# 4. Server-Side Encryption Key
# Used by the backend to encrypt broker API secrets with AES-256-GCM before DB insertion
API_ENCRYPTION_SECRET="generate-a-random-32-byte-hex-string-here"

# 5. Broker & Exchange APIs (Optional defaults; can also be configured securely in UI)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BYBIT_API_KEY=""
BYBIT_API_SECRET=""

# 6. Push & Alert Notifications (Telegram Bot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
